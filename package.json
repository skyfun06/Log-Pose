{
  "name": "log-pose",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Log Pose",
  "author": "Borrel",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "npm run build && npm run server",
    "appli": "npm run build",
    "appli:essai": "npm run build && electron .",
    "appli:installeur": "npm run build && node electron/preparer.cjs && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "imapflow": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "fr.logpose.appli",
    "productName": "Log Pose",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/projet.json",
      "electron/icones/logpose.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "electron/icones/logpose.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Log Pose",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
