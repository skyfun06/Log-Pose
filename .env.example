# Copie ce fichier en ".env" (non commité) et colle ta clé API Anthropic après le "=".
# La clé se récupère sur https://console.anthropic.com/ (section API Keys).
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé par le serveur relais (défaut : claude-haiku-4-5,
# rapide et économique). Pour plus de précision (plus cher) : claude-sonnet-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optionnel : si ta clé API n'est pas rattachée à un workspace, colle ici
# l'ID du workspace (Settings → Workspaces → Default Workspace → ID "wrkspc_...").
# ANTHROPIC_WORKSPACE_ID=

# Optionnel : port du serveur relais (par défaut 3001).
# PORT=3001

# Optionnel : boîtes Gmail affichées dans l'onglet « Courrier », au format
# adresse:motdepasse, séparées par des virgules. Le mot de passe est un
# « mot de passe d'application » (16 lettres), PAS ton mot de passe Google :
# il se crée sur https://myaccount.google.com/apppasswords (validation en
# deux étapes obligatoire), une fois par boîte.
# GMAIL_COMPTES=moi@gmail.com:abcdefghijklmnop,autre@gmail.com:abcdefghijklmnop

# Optionnel : modèle Ollama qui trie le courrier (défaut : qwen3).
# OLLAMA_MODEL=qwen3
