# Copie ce fichier en ".env" (non commité) et colle ta clé API Anthropic après le "=".
# La clé se récupère sur https://console.anthropic.com/ (section API Keys).
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé par le serveur relais (défaut : claude-haiku-4-5,
# rapide et économique). Pour plus de précision (plus cher) : claude-sonnet-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optionnel : si ta clé API n'est pas rattachée à un workspace, colle ici
# l'ID du workspace (Settings → Workspaces → Default Workspace → ID "wrkspc_...").
# ANTHROPIC_WORKSPACE_ID=

# Optionnel : port du serveur relais (par défaut 3001).
# PORT=3001

# Optionnel : boîtes Gmail affichées dans l'onglet « Courrier », au format
# adresse:motdepasse, séparées par des virgules. Le mot de passe est un
# « mot de passe d'application » (16 lettres), PAS ton mot de passe Google :
# il se crée sur https://myaccount.google.com/apppasswords (validation en
# deux étapes obligatoire), une fois par boîte.
# GMAIL_COMPTES=moi@gmail.com:abcdefghijklmnop,autre@gmail.com:abcdefghijklmnop

# Optionnel : modèle Ollama qui trie le courrier (défaut : qwen3).
# OLLAMA_MODEL=qwen3

# Optionnel : modèle Ollama qui regarde les images du second cerveau
# (doit savoir « voir », défaut : qwen3-vl:8b).
# OLLAMA_MODEL_VISION=qwen3-vl:8b

# Optionnel : dossier où le second cerveau range tes fichiers (défaut : server/cerveau).
# CERVEAU_DOSSIER=D:/MesDocuments/cerveau

# Optionnel : TikTok (onglet « Réseaux » : envoi de vidéos en brouillon + stats).
# Crée une appli sur https://developers.tiktok.com/apps (produits « Login Kit »
# et « Content Posting API », scopes user.info.basic, user.info.stats,
# video.list, video.upload). Colle ici son « Client key » et « Client secret ».
# TIKTOK_REDIRECT_URI : l'adresse de retour déclarée dans le Login Kit (https
# obligatoire), par ex. avec « tailscale serve --bg 3001 » :
# https://ton-pc.ton-reseau.ts.net/api/reseaux/tiktok/retour
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://desktop-ld5cq4d.tail5bd32c.ts.net/api/tiktok/retour

# Optionnel : Instagram (onglet « Réseaux » : publication de Reels + stats).
# Compte Instagram professionnel (Créateur ou Entreprise) obligatoire.
# Crée une appli sur https://developers.facebook.com/apps (cas d'usage « API
# Instagram avec connexion Instagram ») et colle l'ID et la clé secrète de
# l'app INSTAGRAM (pas ceux de l'app Facebook).
# INSTAGRAM_REDIRECT_URI : l'URL de redirection déclarée dans « Configurer la
# connexion professionnelle Instagram », par ex. :
# https://ton-pc.ton-reseau.ts.net/api/reseaux/instagram/retour
# INSTAGRAM_URL_PUBLIQUE : Instagram vient chercher les vidéos sur une adresse
# publique. « tailscale funnel --bg --https=8443 3002 » rend public UNIQUEMENT
# le mini-serveur des vidéos en cours d'envoi (port 3002) :
# https://ton-pc.ton-reseau.ts.net:8443
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=
# INSTAGRAM_URL_PUBLIQUE=
# INSTAGRAM_PORT_PUBLIC=3002
