*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json

# Données gardées par le serveur relais (résumés de mails, récaps)
server/.cache-*.json

# Second cerveau : tes fichiers et leur index restent sur ta machine
server/cerveau/

# Données synchronisées entre le PC et le téléphone (habitudes, jeu, budget)
server/.donnees.json*

# Comptes reliés de l'onglet Réseaux (jetons d'accès TikTok, YouTube…)
server/.reseau-*.json*

# Appli de bureau : installeur fabriqué et chemin du projet (propre à ce PC)
release/
electron/projet.json

# QG : historique des missions de l'équipage (reste sur ce PC)
server/.qg-historique.json*
server/.qg-parcours.json*
